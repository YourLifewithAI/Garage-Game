{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.garage-game.invalid/v1/menu.schema.json",
  "title": "EnFractal menu files: the last game played and the builds carried into Challenge",
  "description": "Two small files the opening menu (M7, game/scripts/native/Ui/Menu/) keeps beside the team folders, never read by the companion surface. garage_game.last_game (user://teams/last_game.json, the machine's, written when a game boots as the game, so a launch with --room= counts too): which team, island and mode Continue opens. garage_game.carried_builds (user://teams/<team_id>/carried_builds.json): the islands this team has copied from Creative into Challenge (docs/game/MECHANICS.md section 3, decisions 13 and 44), each once, with the builds (creations) carried over, which count for no Challenge first, souvenir or achievement; the file is also the record that the island's one copy is used.",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "enum": [
        "garage_game.last_game",
        "garage_game.carried_builds",
        "enfractal.last_game",
        "enfractal.carried_builds"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "enum": [
              "garage_game.last_game",
              "enfractal.last_game"
            ]
          }
        },
        "required": [
          "schema"
        ]
      },
      "then": {
        "$ref": "#/$defs/last_game"
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "enum": [
              "garage_game.carried_builds",
              "enfractal.carried_builds"
            ]
          }
        },
        "required": [
          "schema"
        ]
      },
      "then": {
        "$ref": "#/$defs/carried_builds"
      }
    }
  ],
  "$defs": {
    "last_game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "team_id",
        "room_id",
        "mode",
        "difficulty",
        "written_utc"
      ],
      "properties": {
        "schema": {
          "enum": [
            "garage_game.last_game",
            "enfractal.last_game"
          ]
        },
        "version": {
          "const": 1
        },
        "team_id": {
          "$ref": "common.schema.json#/$defs/team_id"
        },
        "room_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "mode": {
          "enum": [
            "creative",
            "challenge",
            "live"
          ]
        },
        "difficulty": {
          "description": "The Challenge save's difficulty; null in any other mode.",
          "enum": [
            "gentle",
            "standard",
            "brave",
            null
          ]
        },
        "written_utc": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        }
      }
    },
    "carried_builds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "team_id",
        "islands"
      ],
      "properties": {
        "schema": {
          "enum": [
            "garage_game.carried_builds",
            "enfractal.carried_builds"
          ]
        },
        "version": {
          "const": 1
        },
        "team_id": {
          "$ref": "common.schema.json#/$defs/team_id"
        },
        "islands": {
          "description": "By room id: one entry per island this team has copied, never removed.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "copied_utc",
              "from_mode",
              "manifest_prefix",
              "difficulty",
              "builds"
            ],
            "properties": {
              "copied_utc": {
                "$ref": "common.schema.json#/$defs/utc_timestamp"
              },
              "from_mode": {
                "const": "creative"
              },
              "manifest_prefix": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "difficulty": {
                "enum": [
                  "gentle",
                  "standard",
                  "brave"
                ]
              },
              "builds": {
                "description": "The ids of the creations the copy carried over, in order.",
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "string",
                  "pattern": "^creation:[A-Za-z0-9_-]{1,64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
