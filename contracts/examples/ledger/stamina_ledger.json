{
  "schema": "garage_game.stamina_ledger_fixture",
  "version": 1,
  "description": "The stamina ledger's arithmetic, for the kernel (M1) and the body (M5) alike. Each step is one physics tick, long for reading: the body reports sprint_s, deep_water_s and dive_s (IStaminaLedger.Report), then the tick runs (VitalsTick with seconds and safely_grounded), then the body reads the gate (IStaminaLedger.Gate). The drain is each seconds times its rate, never below empty; the refill is refill_m_per_s for the seconds not spent running, on standable ground only; reaching empty takes the run away (no_run) until the first bar, first_bar_m, refills to empty_no_run_until_fraction of itself. Compare within tolerance_m.",
  "stamina": {
    "start_m": 0.4,
    "band_m": 0.4,
    "bands": 10,
    "bands_per_bar": 5,
    "running_m_per_s": 0.02,
    "refill_m_per_s": 0.1,
    "deep_water_m_per_s": 0.02,
    "dive_m_per_s": 0.04,
    "climb_m_per_bar_m": 1.5,
    "holding_m_per_s": 0,
    "empty_no_run_until_fraction": 1
  },
  "tolerance_m": 1e-06,
  "cases": [
    {
      "name": "a full starting bar lasts 20 s of running",
      "max_stamina_m": 0.4,
      "first_bar_m": 0.4,
      "stamina_m": 0.4,
      "no_run": false,
      "steps": [
        {
          "seconds": 20,
          "safely_grounded": true,
          "sprint_s": 20,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.0,
            "empty": true,
            "no_run": true
          }
        }
      ]
    },
    {
      "name": "half a bar of running, then walking refills it at 0.10 m a second",
      "max_stamina_m": 0.4,
      "first_bar_m": 0.4,
      "stamina_m": 0.4,
      "no_run": false,
      "steps": [
        {
          "seconds": 10,
          "safely_grounded": true,
          "sprint_s": 10,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.2,
            "empty": false,
            "no_run": false
          }
        },
        {
          "seconds": 1,
          "safely_grounded": true,
          "sprint_s": 0,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.3,
            "empty": false,
            "no_run": false
          }
        }
      ]
    },
    {
      "name": "empty, the body cannot run until the bar is full again",
      "max_stamina_m": 0.4,
      "first_bar_m": 0.4,
      "stamina_m": 0.0,
      "no_run": true,
      "steps": [
        {
          "seconds": 2,
          "safely_grounded": true,
          "sprint_s": 0,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.2,
            "empty": false,
            "no_run": true
          }
        },
        {
          "seconds": 2.1,
          "safely_grounded": true,
          "sprint_s": 0,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.4,
            "empty": false,
            "no_run": false
          }
        }
      ]
    },
    {
      "name": "deep water and diving drain at their rates, and nothing refills in the water",
      "max_stamina_m": 0.4,
      "first_bar_m": 0.4,
      "stamina_m": 0.4,
      "no_run": false,
      "steps": [
        {
          "seconds": 5,
          "safely_grounded": false,
          "sprint_s": 0,
          "deep_water_s": 5,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.3,
            "empty": false,
            "no_run": false
          }
        },
        {
          "seconds": 5,
          "safely_grounded": false,
          "sprint_s": 0,
          "deep_water_s": 0,
          "dive_s": 5,
          "expect": {
            "stamina_m": 0.1,
            "empty": false,
            "no_run": false
          }
        }
      ]
    },
    {
      "name": "without water rates in the pack nothing drains there",
      "max_stamina_m": 0.4,
      "first_bar_m": 0.4,
      "stamina_m": 0.4,
      "no_run": false,
      "omit": [
        "deep_water_m_per_s",
        "dive_m_per_s"
      ],
      "steps": [
        {
          "seconds": 10,
          "safely_grounded": false,
          "sprint_s": 0,
          "deep_water_s": 10,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.4,
            "empty": false,
            "no_run": false
          }
        },
        {
          "seconds": 10,
          "safely_grounded": false,
          "sprint_s": 0,
          "deep_water_s": 0,
          "dive_s": 10,
          "expect": {
            "stamina_m": 0.4,
            "empty": false,
            "no_run": false
          }
        }
      ]
    },
    {
      "name": "a drain never goes below empty",
      "max_stamina_m": 0.4,
      "first_bar_m": 0.4,
      "stamina_m": 0.1,
      "no_run": false,
      "steps": [
        {
          "seconds": 30,
          "safely_grounded": true,
          "sprint_s": 30,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.0,
            "empty": true,
            "no_run": true
          }
        }
      ]
    },
    {
      "name": "running never refills, even on standable ground",
      "max_stamina_m": 0.4,
      "first_bar_m": 0.4,
      "stamina_m": 0.2,
      "no_run": false,
      "steps": [
        {
          "seconds": 5,
          "safely_grounded": true,
          "sprint_s": 5,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.1,
            "empty": false,
            "no_run": false
          }
        }
      ]
    },
    {
      "name": "a tick that only partly runs refills the rest",
      "max_stamina_m": 0.4,
      "first_bar_m": 0.4,
      "stamina_m": 0.2,
      "no_run": false,
      "steps": [
        {
          "seconds": 2,
          "safely_grounded": true,
          "sprint_s": 1,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 0.28,
            "empty": false,
            "no_run": false
          }
        }
      ]
    },
    {
      "name": "two bars: the top band runs down like the first",
      "max_stamina_m": 4.0,
      "first_bar_m": 2.0,
      "stamina_m": 4.0,
      "no_run": false,
      "steps": [
        {
          "seconds": 100,
          "safely_grounded": true,
          "sprint_s": 100,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 2.0,
            "empty": false,
            "no_run": false
          }
        }
      ]
    },
    {
      "name": "the run comes back with the first bar, not the whole bar",
      "max_stamina_m": 2.4,
      "first_bar_m": 2.0,
      "stamina_m": 0.0,
      "no_run": true,
      "steps": [
        {
          "seconds": 19,
          "safely_grounded": true,
          "sprint_s": 0,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 1.9,
            "empty": false,
            "no_run": true
          }
        },
        {
          "seconds": 2,
          "safely_grounded": true,
          "sprint_s": 0,
          "deep_water_s": 0,
          "dive_s": 0,
          "expect": {
            "stamina_m": 2.1,
            "empty": false,
            "no_run": false
          }
        }
      ]
    }
  ]
}
