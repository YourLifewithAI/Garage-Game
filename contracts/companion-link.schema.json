{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.garage-game.invalid/v1/companion-link.schema.json",
  "title": "EnFractal companion and wish runner links: session files and frames",
  "description": "The loopback connection between the companion MCP server and the running game. The game listens on 127.0.0.1 or ::1 only and writes the session file to user://companion/session.json with a fresh 256-bit token per launch. Both sides prove knowledge of the token with HMAC-SHA256 over two fresh nonces, so the token never crosses the socket. Each frame is a 4-byte big-endian length followed by one JSON object, which the sender writes as canonical JSON v1 (UTF-8, numbers in canonical form) so that a frame is the canonical message plus a short envelope; readers accept any strict JSON within the limit, and duplicate keys and non-finite numbers are refused. A wrong proof closes only that connection: there is no lockout. The game binds the principal to the authenticated connection; no request frame carries a principal, an approval or the token. The normal game connection carries garage_game.command / garage_game.query and garage_game.result messages from game-command.schema.json. A separate authenticated runner listener carries only the exact wish.wait / wish.update protocol below and assigns runner:local with no avatar. This static schema describes both transports; the trusted listener enforces which message family its connection may use.",
  "oneOf": [
    {
      "$ref": "#/$defs/session_file"
    },
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/challenge"
    },
    {
      "$ref": "#/$defs/auth"
    },
    {
      "$ref": "#/$defs/ready"
    },
    {
      "$ref": "#/$defs/refused"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "hex256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "session_file": {
      "description": "user://companion/session.json for game commands or user://companion/wish-runner.json for wish control. Each listener writes its own session file atomically at startup and deletes it at exit, with a separate fresh token. Readable only by the player's account. Clients refuse any host that is not a loopback literal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "host",
        "port",
        "token",
        "room_id",
        "pid",
        "created_utc"
      ],
      "properties": {
        "schema": {
          "enum": [
            "garage_game.companion_session",
            "enfractal.companion_session"
          ]
        },
        "version": {
          "type": "integer",
          "const": 1
        },
        "host": {
          "enum": [
            "127.0.0.1",
            "::1"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "token": {
          "description": "256 bits from a CSPRNG, lowercase hex. New every launch. Never sent over the socket.",
          "$ref": "#/$defs/hex256"
        },
        "room_id": {
          "$ref": "common.schema.json#/$defs/token"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "created_utc": {
          "$ref": "common.schema.json#/$defs/utc_timestamp"
        }
      }
    },
    "hello": {
      "description": "Companion to game, first frame. The companion names garage_game.companion_link; the game accepts either id (a companion from before the rename names enfractal.companion_link).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "version",
        "client_nonce"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocol": {
          "enum": [
            "garage_game.companion_link",
            "enfractal.companion_link"
          ]
        },
        "version": {
          "type": "integer",
          "const": 1
        },
        "client_nonce": {
          "$ref": "#/$defs/hex256"
        }
      }
    },
    "challenge": {
      "description": "Game to companion. server_proof = hex(HMAC-SHA256(key = token bytes, msg = protocol + '/1|server|' + client_nonce + '|' + server_nonce)), where protocol is this frame's own: the game names garage_game.companion_link whichever id the hello named, and a companion accepts a challenge naming either id (a game from before the rename names enfractal.companion_link) and proves with the one it names. The companion verifies it before sending anything else, so a listener that does not know the token learns nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "version",
        "server_nonce",
        "server_proof"
      ],
      "properties": {
        "type": {
          "const": "challenge"
        },
        "protocol": {
          "enum": [
            "garage_game.companion_link",
            "enfractal.companion_link"
          ]
        },
        "version": {
          "type": "integer",
          "const": 1
        },
        "server_nonce": {
          "$ref": "#/$defs/hex256"
        },
        "server_proof": {
          "$ref": "#/$defs/hex256"
        }
      }
    },
    "auth": {
      "description": "Companion to game. client_proof = hex(HMAC-SHA256(key = token bytes, msg = protocol + '/1|client|' + client_nonce + '|' + server_nonce)), with the challenge's protocol, compared in constant time.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "client_proof"
      ],
      "properties": {
        "type": {
          "const": "auth"
        },
        "client_proof": {
          "$ref": "#/$defs/hex256"
        }
      }
    },
    "ready": {
      "description": "Game to authenticated client after a valid proof. The normal game listener assigns a game principal and nonempty avatar. The separate wish runner listener assigns exactly runner:local and an empty avatar. The client never chooses its role.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "session_id",
        "principal",
        "avatar",
        "room_id",
        "limits"
      ],
      "properties": {
        "type": {
          "const": "ready"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "principal": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "room_id": {
          "$ref": "common.schema.json#/$defs/token"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_request_frame",
            "max_response_frame"
          ],
          "properties": {
            "max_request_frame": {
              "type": "integer",
              "minimum": 65536
            },
            "max_response_frame": {
              "type": "integer",
              "minimum": 262144
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "principal": {
              "$ref": "common.schema.json#/$defs/principal_id"
            },
            "avatar": {
              "pattern": "^avatar:[A-Za-z0-9_-]{1,64}$"
            }
          }
        },
        {
          "properties": {
            "principal": {
              "const": "runner:local"
            },
            "avatar": {
              "const": ""
            }
          }
        }
      ]
    },
    "refused": {
      "description": "Game to companion, then the game closes the connection.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code"
      ],
      "properties": {
        "type": {
          "const": "refused"
        },
        "code": {
          "enum": [
            "hello_invalid",
            "handshake_invalid",
            "handshake_timeout",
            "auth_failed",
            "busy",
            "frame_invalid"
          ]
        }
      }
    },
    "request": {
      "description": "Authenticated client to its listener. The game endpoint accepts one garage_game.command or garage_game.query; the separate runner endpoint accepts only wish.wait or wish.update. The trusted endpoint enforces the connection role; this schema is their static union.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "seq",
        "message"
      ],
      "properties": {
        "type": {
          "const": "request"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "message": {
          "oneOf": [
            {
              "$ref": "game-command.schema.json#/$defs/command"
            },
            {
              "$ref": "game-command.schema.json#/$defs/query"
            },
            {
              "$ref": "#/$defs/runner_request"
            }
          ]
        }
      }
    },
    "response": {
      "description": "Game to authenticated client, echoing seq. The game endpoint returns garage_game.result; the separate runner endpoint returns only a fixed runner_response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "seq",
        "message"
      ],
      "properties": {
        "type": {
          "const": "response"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "message": {
          "oneOf": [
            {
              "$ref": "game-command.schema.json#/$defs/result"
            },
            {
              "$ref": "#/$defs/runner_response"
            }
          ]
        }
      }
    },
    "wish_id": {
      "type": "string",
      "minLength": 31,
      "maxLength": 31,
      "pattern": "^wish:[a-z2-7]{26}$"
    },
    "runner_result_code": {
      "enum": [
        "completed",
        "failed",
        "unsupported",
        "cancelled"
      ]
    },
    "runner_request": {
      "description": "Only the dedicated authenticated runner listener accepts these control messages. Game actions still use the normal companion connection and its ordinary authority checks.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "wish.wait"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "wish.update"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "wish_id",
                "status",
                "result_code"
              ],
              "properties": {
                "wish_id": {
                  "$ref": "#/$defs/wish_id"
                },
                "status": {
                  "enum": [
                    "running",
                    "completed",
                    "failed",
                    "unsupported",
                    "cancelled"
                  ]
                },
                "result_code": {
                  "$ref": "#/$defs/runner_result_code"
                }
              },
              "description": "Running is a heartbeat with a fixed result code; terminal reports must pair the same status and result_code. Reports cannot supply action receipts, approvals or prose. The host derives the final wish status from its own receipts.",
              "oneOf": [
                {
                  "properties": {
                    "status": {
                      "const": "running"
                    }
                  }
                },
                {
                  "properties": {
                    "status": {
                      "const": "completed"
                    },
                    "result_code": {
                      "const": "completed"
                    }
                  }
                },
                {
                  "properties": {
                    "status": {
                      "const": "failed"
                    },
                    "result_code": {
                      "const": "failed"
                    }
                  }
                },
                {
                  "properties": {
                    "status": {
                      "const": "unsupported"
                    },
                    "result_code": {
                      "const": "unsupported"
                    }
                  }
                },
                {
                  "properties": {
                    "status": {
                      "const": "cancelled"
                    },
                    "result_code": {
                      "const": "cancelled"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "runner_wish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wish_id",
        "text",
        "room_id"
      ],
      "properties": {
        "wish_id": {
          "$ref": "#/$defs/wish_id"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/display_text",
          "minLength": 1,
          "maxLength": 280
        },
        "room_id": {
          "$ref": "common.schema.json#/$defs/token"
        },
        "aim_id": {
          "$ref": "common.schema.json#/$defs/entity_id"
        }
      }
    },
    "runner_response": {
      "description": "Fixed host replies. A completed runner report can become granted, partial or failed only from host-observed game receipts. No model-authored success description is accepted. A completed report is refused with not_ready while an accepted action (a goal job) is still running.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "wish"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "wish": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/runner_wish"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "status"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "status": {
              "enum": [
                "running",
                "granted",
                "partial",
                "failed",
                "unsupported",
                "cancelled"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "error"
          ],
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "not_ready",
                    "request_invalid",
                    "permission_denied",
                    "invalid_args",
                    "target_not_found",
                    "budget_exceeded"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
