[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="companion"
3d_physics/layer_4="water"
3d_physics/layer_5="hidden"
3d_render/layer_1="world"
3d_render/layer_19="player_body"
3d_render/layer_20="gubble_body"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.62, 0.76, 0.82, 1)
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
global_illumination/voxel_gi/quality=1
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=2
camera/depth_of_field/depth_of_field_use_jitter=true

[shader_globals]

intro_area={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
intro_colour={
"type": "sampler2D",
"value": ""
}
intro_grow={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
intro_rise={
"type": "vec4",
"value": Vector4(1, 1, 0, 0)
}
intro_start={
"type": "sampler2D",
"value": ""
}
